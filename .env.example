PORT=3000
# Azure SQL endpoint. No SQL username or password is used by the application.
DB_SERVER=your-server.database.windows.net
DB_NAME=your-database
# Optional for a user-assigned managed identity in Azure; omit for VS Code sign-in.
DB_AUTH_CLIENT_ID=
# Optional when Azure SQL is listening on a non-default port.
DB_PORT=
# Required in production; generate a random value of at least 32 characters.
SESSION_SECRET=
# SMTP settings for invitation email (required to invite department managers).
APP_BASE_URL=https://promographe.example.ca
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Or Azure Communication Services Email (used when SMTP is not set): the sender address plus
# either the resource connection string, or its endpoint with the managed identity granted
# the "Communication and Email Service Owner" role.
ACS_EMAIL_FROM=
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_ENDPOINT=
# Optional "Se connecter avec Microsoft" (Microsoft Entra ID app registration, single tenant).
# Redirect URI to register (type Web): <APP_BASE_URL>/api/auth/microsoft/callback
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Directory (tenant) ID, a GUID.
AUTH_MICROSOFT_TENANT_ID=
# Comma-separated company email domains, e.g. promographe.com. These accounts sign in with
# Microsoft only (no password), and a first sign-in creates the employee account without an
# invitation (the employee picks their department). Other domains still need an invitation.
AUTH_MICROSOFT_DOMAINS=
